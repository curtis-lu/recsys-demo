%% ===========================================================================
%% evaluation pipeline node graph
%% 唯一真實來源：src/recsys_tfb/pipelines/evaluation/pipeline.py::create_pipeline
%% node 函式在 nodes.py，只有這條 pipeline 用的機制在 steps/，共用計算在 evaluation/ 套件
%% 姊妹圖：dataset-pipeline.mmd、training-pipeline.mmd、inference-pipeline.mmd
%%（同一套圖例，多出／少掉的形狀見下）

%% 圖例
%%   [( 圓柱 )]    來源表（catalog 的 read_only Hive table）
%%   [/ 斜角 /]    直接被造成「資料列」的 config 值。過濾條件類的
%%                 （evaluation.snap_date、k_values）不畫。
%%   [[ 雙框 ]]    別的 pipeline 落地的版本化 artifact（不是表，是檔案）
%%   [ 方框 ]      node，框內是 node name（可直接餵給 --from-node / --only-node）
%%   ([ 實線膠囊 ]) 落地的 catalog 條目（Hive table / JSON 檔）
%%   ([ 虛線膠囊 ]) MemoryDataset：catalog.yaml 沒有這個名字，只活在這次 run 的記憶體
%%   本圖沒有 {{ 六角 }} 閘，也沒有 > 旗標 ]。evaluation 的檢查都寫在 node 裡、標為
%%   前置檢查，不是獨立的閘 node：
%%     prepare_eval_data          label_table 重複 key（bug 10）
%%     compute_baseline_metrics   lookback 視窗沒有歷史（bug 1）
%%     generate_report            設定指紋不合（bug 2）
%%     restrict_to_common         共同 query group（time × entity）或 item 為空（B3，在 common_universe 裡）
%%   唯一獨立成 node 的檢查是 --compare-only 的第一個 node（該月沒有資料就擋，見下）。

%% #351 起 evaluation_metrics、baseline_metrics 落地成 JSONDataset
%%   （data/evaluation/<model_version>/<snap_date>/metrics.json 與同目錄
%%   baseline_metrics.json，皆含 config_fingerprint；report.sections.popularity_baseline: false
%%   時 baseline 是 {"enabled": false, "config_fingerprint": ...} stub），跟
%%   report_aggregates 一樣畫成實線膠囊（有 catalog entry）。
%%   #536 起報表只讀落地結果：compare_to_baseline 算模型對 baseline 的差值（baseline_comparison.json），
%%   resolve_display_ks 把每張表要印的 K 切好（display_ks.json），兩個 node 都不跑 Spark。
%%   改了 report.display.compare_k 要 --from-node resolve_display_ks。
%%   generate_report 的輸入全部落地（#532 拿掉最後一個 MemoryDataset 輸入，
%%   也就是診斷頁清單），所以切片的停止條件 can_load（＝檔案在不在）
%%   讓 `--only-node generate_report` 不會自動補跑任何 node，也不會沿線把
%%   prepare_eval_data / compute_metrics / compute_baseline_metrics
%%   拉回來重跑全量 Spark。
%%   generate_report 是純函式（無 varargs）本來就是為了「便宜重繪」
%%   而做的投資，#351 之前這條 catalog 缺口把它抵銷掉，補上後才真的便宜。
%%   連帶：那些落地的 JSON 路徑只用 (model_version, snap_date) 當 key。
%%   #342 起每份落地 JSON 內帶 config_fingerprint（只涵蓋「算的」設定）：
%%   改了算的設定再 --only-node 重繪，generate_report
%%   會 raise 並指出該 --from-node 哪個 node；只改畫的設定（report.sections 其餘鍵）
%%   照常重繪，report.display.compare_k 例外（見上）。分類見 docs/pipelines/evaluation.md §7.2。

%% #352 起（ADR-0018 決定 1）prepare_eval_data 的 join 結果直接落地為
%%   enriched_eval_predictions（既有 Hive 表：partition_filter model_version、
%%   partition_cols snap_date），不再先產出一份未落地的 join 結果、
%%   再由獨立的 persist node 寫表——那個 persist node 已刪除，DAG 上不再有
%%   它的名字。join 只算這一次；compute_metrics／
%%   compute_baseline_metrics／compute_report_aggregates／
%%   restrict_to_common 全部從 enriched_eval_predictions
%%   讀表，讀到的是這個 model_version 評估過的所有月份，各自用
%%   restrict_to_current_eval_partitions 篩回本次評估日期（一個或多個），並逐日期
%%   比對分區自帶的設定指紋（#374）。--compare-only 沒有
%%   prepare_eval_data，一樣直接讀這張表；validate_enriched_eval_predictions_present
%%   維持零輸出檢查（該月沒有資料就擋）。

%% 兩種模式的 node 一樣（#532 起）
%%   --post-training 與監控模式（預設，含 --compare）只差 prepare_eval_data 讀哪張預測表、
%%   用哪張母體表分群；evaluation 沒有診斷頁，不再有只屬於某一種模式的 node。

flowchart TB

  %% ------------------------ 來源 ------------------------
  subgraph SRC[" 預測來源（二選一）＋ ground truth ＋ 分群 "]
    direction LR
    src_ranked[("ranked_predictions<br/><small>預設模式 ・ inference 發布的正式排序</small>")]
    src_teval[("training_eval_predictions<br/><small>--post-training ・ 沿用 training 當時的 test label</small>")]
    src_label[("label_table<br/><small>ground truth ・ 缺 row 即視為負例</small>")]
    src_seg[("sample_pool ／ inference_population<br/><small>該模式的母體表（post-training ／ 監控）・ 以 (time, entity) 補分群欄<br/>segment_sources.&lt;欄&gt;.table 可覆寫</small>")]
  end

  cfg_cat[/"evaluation.item_categories<br/><small>mapping（手寫）或 column（取自 sample_pool 的一欄，只在 --post-training，#379）<br/>啟用時整套指標對大類粒度再跑第二輪</small>"/]

  %% ---------------------- 主鏈：整理 ----------------------
  n_prep["prepare_eval_data<br/><small>篩 model_version 與 snap_date ・ label_table 重複 key 就擋 ・ left join 補 label<br/>post-training 依 score（同分按 item）重算 rank、轉 BIGINT ・ join segment 欄（母體表缺欄只 WARN）</small>"]
  o_enriched(["enriched_eval_predictions　★Hive<br/><small>join 在此算一次、以本月 partition 落地（dynamic overwrite）・ 一列 ＝ 一個 (time, entity, item) 候選<br/>存有這個 model_version 評估過的所有月份 ・ 每個讀者各自 restrict_to_current_eval_partitions 篩回本次評估日期並驗分區指紋</small>"])
  d_segcols(["evaluation_segment_columns<br/><small>JSON ・ joined ／ sources ／ missing<br/>分群的 node 照 joined 分群、不看 frame 欄位</small>"])
  d_catmap(["evaluation_item_categories<br/><small>JSON ・ column ／ mapping（只有欄模式有內容）<br/>optional：#379 之前的評估目錄沒有它</small>"])

  %% ---------------------- 指標流 ----------------------
  n_rowfacts["compute_row_facts<br/><small>列的事實（跟分數無關）：dataset_overview ＋ query group 數 ＋ 無正例／全正組數<br/>item 與（可選）大類粒度 ・ 模型與 baseline 共用（#535）</small>"]
  d_rowfacts(["evaluation_row_facts<br/><small>JSON</small>"])
  n_metrics["compute_metrics<br/><small>overall / per_item / per_segment / per_item_segment<br/>＋ macro_avg ＋ 母體帳 population ＋（可選）category</small>"]
  d_metrics(["evaluation_metrics<br/><small>JSON</small>"])
  n_baseline["compute_baseline_metrics<br/><small>popularity baseline：近 lookback_months 的購買數當分數<br/>同一批列、跟模型同一套指標計算（含 macro）</small>"]
  d_baseline(["baseline_metrics<br/><small>JSON</small>"])
  n_pq["compute_prediction_quality<br/><small>每一列候選當二元預測 ・ 一次 groupBy(item, 細箱) ・ 不排除無正例的 query group<br/>report.sections.prediction_quality: false（框架預設）時只寫 stub</small>"]
  d_pq(["prediction_quality_metrics<br/><small>JSON</small>"])
  n_agg["compute_report_aggregates<br/><small>主報表名次分布段的 Spark 端聚合（bin 計數／quartile／rank 矩陣）</small>"]
  d_agg(["evaluation_report_aggregates<br/><small>JSON</small>"])

  %% ---------------------- 比較層與 K 截斷 ----------------------
  n_cmpbase["compare_to_baseline<br/><small>不跑 Spark ・ 模型對 baseline 每格的這次、對照、差（全部 K）<br/>＋ 四項能不能比的標註（all、macro item、組數、分群欄）</small>"]
  d_cmpbase(["baseline_comparison<br/><small>JSON ・ baseline_comparison.json</small>"])
  n_dispk["resolve_display_ks<br/><small>不跑 Spark ・ 每張表要印的 K，超過該粒度 all 的整數 K 已濾掉<br/>改 report.display.compare_k 從這裡接續</small>"]
  d_dispk(["evaluation_display_ks<br/><small>JSON ・ display_ks.json</small>"])

  %% ---------------------- 匯流 ----------------------
  n_report["generate_report<br/><small><b>純函式</b>：輸入全部是落地的 JSON、無 varargs、不含任何 Spark 物件或 action</small>"]
  o_report(["evaluation_report　★ report.html<br/><small>data/evaluation/&lt;model_version&gt;/&lt;YYYYMMDD&gt;/</small>"])

  %% ---------------------- 比較模式（追加） ----------------------
  subgraph CMP[" --compare &lt;key&gt; 追加這六個 node（--compare-only 則跑這六個 ＋ 一個驗證 node，共七個）・ 前三個跑 Spark，後三個只讀落地的 JSON "]
    n_validate["validate_enriched_eval_predictions_present<br/><small>僅 --compare-only ・ 該 snap_date 沒有資料就擋</small>"]
    n_loadb["load_compare_predictions<br/><small>依 compare_sources 載入 Model B ・ 欄位與 item mapping</small>"]
    d_braw(["compare_predictions_raw"])
    n_restrict["restrict_to_common<br/><small>取共同 query group 與 item ・ 雙方重新排名<br/>B 一律抄 A 的 label</small>"]
    d_common(["eval_predictions_common<br/>compare_predictions_common"])
    d_cover(["compare_coverage<br/><small>JSON ・ compare_coverage.json</small>"])
    n_cmetrics["compute_compare_metrics<br/><small>共同母體上兩側各算列的事實與指標（含母體帳）<br/>只有 Model A 照 evaluation_segment_columns 分群</small>"]
    d_cfa(["compare_row_facts_a<br/><small>JSON</small>"])
    d_cma(["compare_metrics_a<br/><small>JSON</small>"])
    d_cfb(["compare_row_facts_b<br/><small>JSON</small>"])
    d_cmb(["compare_metrics_b<br/><small>JSON</small>"])
    n_csource["compare_to_source<br/><small>不跑 Spark ・ Model A 對 Model B 每格的這次、對照、差（全部 K）<br/>＋ 四項能不能比的標註 ・ 比對「跟誰比」的身分</small>"]
    d_csource(["source_comparison<br/><small>JSON</small>"])
    n_cdispk["resolve_comparison_display_ks<br/><small>不跑 Spark ・ 比較報表每張表要印的 K 與列<br/>改 compare_k 從這裡接續</small>"]
    d_cdispk(["comparison_display_ks<br/><small>JSON</small>"])
    n_creport["generate_comparison_report<br/><small><b>純函式</b>：只讀落地的 JSON，不跑 Spark、不取差值、不截斷 K</small>"]
    o_creport(["evaluation_comparison_report　★ report_comparison.html"])
  end

  %% ---------------------------- 邊 ------------------------------
  src_ranked --> n_prep
  src_teval --> n_prep
  src_label --> n_prep
  src_seg -- "先讀欄位清單（只碰 metastore）<br/>dropDuplicates(key) 後 left join" --> n_prep
  n_prep --> o_enriched
  n_prep --> d_segcols
  d_segcols --> n_rowfacts
  d_segcols --> n_metrics
  d_segcols --> n_baseline
  d_segcols -- "--compare-only：讀寫 enriched 那次落地的" --> n_cmetrics
  d_segcols -- "只取 joined：分區指紋的一部分（#374）" --> n_agg
  d_segcols -- "只取 joined" --> n_pq
  d_segcols --> n_restrict
  d_segcols --> n_validate
  cfg_cat -- "column：只讀評估月份的 sample_pool<br/>一個 item 兩個大類就擋（B18）" --> n_prep
  n_prep --> d_catmap
  d_catmap --> n_rowfacts
  d_catmap --> n_metrics
  d_catmap --> n_baseline
  d_catmap -- "--compare-only：欄模式才需要" --> n_cmetrics

  o_enriched --> n_rowfacts
  n_rowfacts --> d_rowfacts
  d_rowfacts -- "組數與 item 數" --> n_metrics
  d_rowfacts -- "組數與 item 數" --> n_baseline
  o_enriched --> n_metrics
  cfg_cat --> n_metrics
  n_metrics --> d_metrics
  o_enriched --> n_baseline
  src_label -- "近 lookback_months 的歷史窗<br/>（查無資料時 raise，bug 1）" --> n_baseline
  n_baseline --> d_baseline
  o_enriched --> n_agg
  n_agg --> d_agg
  o_enriched --> n_pq
  n_pq --> d_pq

  d_metrics --> n_cmpbase
  d_baseline --> n_cmpbase
  n_cmpbase --> d_cmpbase
  d_metrics --> n_dispk
  d_cmpbase --> n_dispk
  n_dispk --> d_dispk

  d_rowfacts --> n_report
  d_metrics --> n_report
  d_baseline --> n_report
  d_agg --> n_report
  d_pq --> n_report
  d_cmpbase --> n_report
  d_dispk --> n_report
  n_report --> o_report

  o_enriched --> n_restrict
  o_enriched -- "--compare-only：catalog 依 model_version 讀回" --> n_validate
  n_validate --> n_restrict
  n_loadb --> d_braw
  d_braw --> n_restrict
  n_restrict --> d_common
  n_restrict --> d_cover
  d_common --> n_cmetrics
  n_cmetrics --> d_cfa
  n_cmetrics --> d_cma
  n_cmetrics --> d_cfb
  n_cmetrics --> d_cmb
  d_cma --> n_csource
  d_cmb --> n_csource
  n_csource --> d_csource
  d_csource --> n_cdispk
  n_cdispk --> d_cdispk
  d_cover --> n_creport
  d_cfa --> n_creport
  d_csource --> n_creport
  d_cdispk --> n_creport
  n_creport --> o_creport

  %% ---------------------------- 樣式 -------------------------------
  classDef src fill:#a5d8ff,stroke:#1971c2,stroke-width:1.5px,color:#0b3d6b
  classDef cfg fill:#e5dbff,stroke:#7048e8,stroke-width:1.5px,color:#3b2a7a
  classDef nd fill:#ffffff,stroke:#57606a,stroke-width:1.5px,color:#1f2328
  classDef data fill:#f1f3f5,stroke:#adb5bd,stroke-width:1px,color:#343a40
  classDef mem fill:#ffffff,stroke:#adb5bd,stroke-width:1px,stroke-dasharray:5 3,color:#6a737d
  classDef out fill:#b2f2bb,stroke:#2f9e44,stroke-width:1.5px,color:#14532d

  class src_ranked,src_teval,src_label,src_seg src
  class cfg_cat cfg
    class n_prep,n_rowfacts,n_metrics,n_baseline,n_pq,n_agg,n_cmpbase,n_dispk,n_report,n_validate,n_loadb,n_restrict,n_cmetrics,n_csource,n_cdispk,n_creport nd
  class d_agg,d_rowfacts,d_metrics,d_baseline,d_pq,d_cmpbase,d_dispk data
  class d_braw,d_common mem
  class d_cover,d_cfa,d_cma,d_cfb,d_cmb,d_csource,d_cdispk data
  class o_report,o_enriched,o_creport out
