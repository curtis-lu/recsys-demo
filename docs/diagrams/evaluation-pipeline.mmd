%% ===========================================================================
%% evaluation pipeline node graph
%% 唯一真實來源：src/recsys_tfb/pipelines/evaluation/pipeline.py::create_pipeline
%% node 函式在 nodes.py，只有這條 pipeline 用的機制在 steps/，共用計算在 evaluation/ 套件
%% 姊妹圖：dataset-pipeline.mmd、training-pipeline.mmd、inference-pipeline.mmd
%%（同一套圖例，多出／少掉的形狀見下）

%% 圖例
%%   [( 圓柱 )]    來源表（catalog 的 read_only Hive table）
%%   [/ 斜角 /]    直接被造成「資料列」的 config 值。過濾條件類的
%%                 （evaluation.snap_date、k_values）不畫。
%%   [[ 雙框 ]]    別的 pipeline 落地的版本化 artifact（不是表，是檔案）
%%   [ 方框 ]      node，框內是 node name（可直接餵給 --from-node / --only-node）
%%   ([ 實線膠囊 ]) 落地的 catalog 條目（Hive table / JSON 檔）
%%   ([ 虛線膠囊 ]) MemoryDataset：catalog.yaml 沒有這個名字，只活在這次 run 的記憶體
%%   本圖沒有 {{ 六角 }} 閘，也沒有 > 旗標 ]。evaluation 的檢查都寫在 node 裡、標為
%%   前置檢查，不是獨立的閘 node：
%%     prepare_eval_data          label_table 重複 key（bug 10）
%%     compute_baseline_metrics   lookback 視窗沒有歷史（bug 1）
%%     generate_report、render_diagnosis_pages、吃別項診斷結果的診斷 node
%%                                設定指紋不合（bug 2）；render_diagnosis_pages 另擋診斷結果接錯（bug 9）
%%     restrict_to_common         共同 query group（time × entity）或 item 為空（B3，在 common_universe 裡）
%%   唯一獨立成 node 的檢查是 --compare-only 的第一個 node（B4，見下）。

%% #351 起 evaluation_metrics、baseline_metrics 落地成 JSONDataset
%%   （data/evaluation/<model_version>/<snap_date>/metrics.json 與同目錄
%%   baseline_metrics.json，皆含 config_fingerprint；report.sections.baseline: false
%%   時 baseline 是 {"enabled": false, "config_fingerprint": ...} stub），跟四份診斷
%%   JSON、metric_ci、report_aggregates 一樣畫成實線膠囊（有 catalog entry）。
%%   仍是虛線膠囊（MemoryDataset，沒有 catalog entry）的只剩 evaluation_diagnosis_pages。
%%   後果：切片的停止條件是 can_load（＝檔案在不在），所以 `--only-node generate_report`
%%   現在只會自動補跑一個不碰 Spark 的 node——監控模式是 no_diagnosis_pages，
%%   --post-training 是 render_diagnosis_pages（它的四個診斷輸入本身已落地，
%%   can_load 直接讀舊檔，不會重跑診斷）；不會再沿線把
%%   prepare_eval_data / compute_metrics / compute_baseline_metrics
%%   拉回來重跑全量 Spark。
%%   generate_report 是純函式（7 個必填輸入、無 varargs）本來就是為了「便宜重繪」
%%   而做的投資，#351 之前這條 catalog 缺口把它抵銷掉，補上後才真的便宜。
%%   連帶：那些落地的 JSON 路徑只用 (model_version, snap_date) 當 key。
%%   #342 起每份落地 JSON 內帶 config_fingerprint（只涵蓋「算的」設定）：
%%   改了算的設定再 --only-node 重繪，render_diagnosis_pages／generate_report
%%   會 raise 並指出該 --from-node 哪個 node；只改畫的設定（report.display.* 等）
%%   照常重繪。分類見 docs/pipelines/evaluation.md §7.2。

%% #352 起（ADR-0018 決定 1）prepare_eval_data 的 join 結果直接落地為
%%   enriched_eval_predictions（既有 Hive 表：partition_filter model_version、
%%   partition_cols snap_date），不再先產出一份未落地的 join 結果、
%%   再由獨立的 persist node 寫表——那個 persist node 已刪除，DAG 上不再有
%%   它的名字。join 只算這一次；compute_metrics／
%%   compute_baseline_metrics／compute_report_aggregates／
%%   draw_diagnosis_sample_node／restrict_to_common 全部從 enriched_eval_predictions
%%   讀表，讀到的是這個 model_version 評估過的所有月份，各自用
%%   restrict_to_current_eval_partitions 篩回本次評估日期（一個或多個），並逐日期
%%   比對分區自帶的設定指紋（#374）。--compare-only 沒有
%%   prepare_eval_data，一樣直接讀這張表；validate_enriched_eval_predictions_present
%%   維持零輸出檢查（B4：該月無資料就擋）。

%% 兩種模式的形狀不同（ADR-0018 決定 5）
%%   registry 診斷與 render_diagnosis_pages 只在 --post-training 組出來；
%%   監控模式（預設，含 --compare）改組 no_diagnosis_pages：零讀取、回空清單，
%%   只為了讓 generate_report 的診斷頁位置輸入有人產出。它不能沿用
%%   render_diagnosis_pages——那個要求每項 registry 診斷各一份帶名字的結果，
%%   監控模式一份都沒算。

%% render_diagnosis_pages 的四條入邊是資料流（#342 起；之前是虛線：值不讀、按檔名讀磁碟）
%%   函式簽章是 (parameters, *diagnosis_results)，畫的就是這四份結果。畫之前檢查
%%   第 i 個結果帶著 DIAGNOSES[i] 的名字、設定指紋與目前的「算的」設定一致，不合就 raise。
%%   同一組 inputs 另外買到兩件事：
%%   (1) 執行順序：拓樸排序只看 node.inputs，排在所有診斷之後才拿得到這次的結果。
%%   (2) 切片擴張：JSON 已落地時 --only-node 不重算（讀回後比對指紋），
%%       全新 model_version 時才自動往上補算。

%% 為什麼診斷抽樣只抽一次
%%   draw_diagnosis_sample_node 的產出被 compute_metric_ci 與各項診斷共用。
%%   各自重抽（同 seed）結果會相同，但那是 N 次全量掃描；更重要的是
%%   「同一份樣本」本身是正確性性質——CI 與診斷講的必須是同一批 query。

%% 四項診斷為什麼長得一模一樣
%%   它們由 registry（diagnosis.metric.contract.DIAGNOSES）導出，node 函式
%%   由 make_diagnosis_node 生成。加第五項＝新增一個子套件 ＋ registry 補一行，
%%   report_builder 零改動。model_capacity 是唯一宣告自己 INPUTS 的那個
%%   （吃 gain_ledger ＋ item_ability，不吃共用抽樣）。

flowchart TB

  %% ------------------------ 來源 ------------------------
  subgraph SRC[" 預測來源（二選一）＋ ground truth ＋ 分群 "]
    direction LR
    src_ranked[("ranked_predictions<br/><small>預設模式 ・ inference 發布的正式排序</small>")]
    src_teval[("training_eval_predictions<br/><small>--post-training ・ 沿用 training 當時的 test label</small>")]
    src_label[("label_table<br/><small>ground truth ・ 缺 row 即視為負例</small>")]
    src_seg[("sample_pool ／ inference_population<br/><small>該模式的母體表（post-training ／ 監控）・ 以 (time, entity) 補分群欄<br/>segment_sources.&lt;欄&gt;.table 可覆寫</small>")]
  end

  art_gain[["gain_ledger<br/><small>training 落地 ・ optional，可缺席</small>"]]
  cfg_cat[/"evaluation.item_categories.mapping<br/><small>啟用時整套指標對大類粒度再跑第二輪</small>"/]

  %% ---------------------- 主鏈：整理 ----------------------
  n_prep["prepare_eval_data<br/><small>篩 model_version 與 snap_date ・ label_table 重複 key 就擋 ・ left join 補 label<br/>post-training 依 score（同分按 item）重算 rank、轉 BIGINT ・ join segment 欄（母體表缺欄只 WARN）</small>"]
  o_enriched(["enriched_eval_predictions　★Hive<br/><small>join 在此算一次、以本月 partition 落地（dynamic overwrite）・ 一列 ＝ 一個 (time, entity, item) 候選<br/>存有這個 model_version 評估過的所有月份 ・ 每個讀者各自 restrict_to_current_eval_partitions 篩回本次評估日期並驗分區指紋</small>"])
  d_segcols(["evaluation_segment_columns<br/><small>JSON ・ joined ／ sources ／ missing<br/>分群的 node 照 joined 分群、不看 frame 欄位</small>"])

  %% ---------------------- 指標流 ----------------------
  n_metrics["compute_metrics<br/><small>overall / per_item / per_segment / per_item_segment<br/>＋ macro_avg ＋ dataset_overview ＋（可選）category</small>"]
  d_metrics(["evaluation_metrics<br/><small>JSON</small>"])
  n_baseline["compute_baseline_metrics<br/><small>popularity baseline：近 lookback_months 的購買數當分數</small>"]
  d_baseline(["baseline_metrics<br/><small>JSON</small>"])
  n_pq["compute_prediction_quality<br/><small>每一列候選當二元預測 ・ 一次 groupBy(item, 細箱) ・ 不排除無正例的 query group<br/>report.sections.prediction_quality: false（框架預設）時只寫 stub</small>"]
  d_pq(["prediction_quality_metrics<br/><small>JSON</small>"])
  n_agg["compute_report_aggregates<br/><small>主報表診斷區的 Spark 端聚合（bin 計數／quartile／rank 矩陣）</small>"]
  d_agg(["evaluation_report_aggregates<br/><small>JSON</small>"])

  %% ---------------------- 診斷流 ----------------------
  n_sample["draw_diagnosis_sample_node<br/><small>單位＝有正例的 query ・ 只抽一次，下游共用</small>"]
  d_sample(["diagnosis_sample"])
  n_ci["compute_metric_ci<br/><small>per-item AP 與 macro 的 cluster bootstrap（cluster ＝ entity）</small>"]
  d_ci(["evaluation_metric_ci<br/><small>JSON</small>"])
  subgraph POST[" 僅 --post-training：registry 診斷 ＋ 分頁 "]
    n_cs["diagnose_config_shift"]
    d_cs(["evaluation_config_shift<br/><small>JSON</small>"])
    n_ia["diagnose_item_ability"]
    d_ia(["evaluation_item_ability<br/><small>JSON</small>"])
    n_mc["diagnose_model_capacity"]
    d_mc(["evaluation_model_capacity<br/><small>JSON</small>"])
    n_sup["diagnose_suppression"]
    d_sup(["evaluation_suppression<br/><small>JSON</small>"])
    n_pages["render_diagnosis_pages<br/><small>畫這次的診斷結果 ・ 先比對名字與設定指紋 ・ 停用的那項就沒有那一頁</small>"]
  end
  subgraph MON[" 僅監控模式（預設，含 --compare） "]
    n_nopages["no_diagnosis_pages<br/><small>零讀取 ・ 回空清單：只為了 generate_report 的診斷頁位置輸入</small>"]
  end
  d_pages(["evaluation_diagnosis_pages<br/><small>兩種模式各由一個 node 產出</small>"])

  %% ---------------------- 匯流 ----------------------
  n_report["generate_report<br/><small><b>純函式</b>：7 個必填輸入、無 varargs、不含任何 Spark 物件或 action</small>"]
  o_report(["evaluation_report　★ report.html<br/><small>data/evaluation/&lt;model_version&gt;/&lt;YYYYMMDD&gt;/</small>"])

  %% ---------------------- 比較模式（追加） ----------------------
  subgraph CMP[" --compare &lt;key&gt; 追加這三個 node（--compare-only 則只跑這三個 ＋ 一個驗證 node） "]
    n_validate["validate_enriched_eval_predictions_present<br/><small>僅 --compare-only ・ B4：該 snap_date 無 row 就 fail loud</small>"]
    n_loadb["load_compare_predictions<br/><small>依 compare_sources 載入 Model B ・ 欄位與 item mapping</small>"]
    d_braw(["compare_predictions_raw"])
    n_restrict["restrict_to_common<br/><small>取共同 query group 與 item ・ 雙方重新排名<br/>B 一律抄 A 的 label</small>"]
    d_common(["eval_predictions_common<br/>compare_predictions_common<br/>compare_coverage_partial"])
    n_creport["generate_comparison_report<br/><small>兩側各重跑一次 compute_all_metrics，再組 HTML（算與畫同一個 node）<br/>只有 Model A 照 evaluation_segment_columns 分群</small>"]
    o_creport(["evaluation_comparison_report　★ report_comparison.html"])
  end

  %% ---------------------------- 邊 ------------------------------
  src_ranked --> n_prep
  src_teval --> n_prep
  src_label --> n_prep
  src_seg -- "先讀欄位清單（只碰 metastore）<br/>dropDuplicates(key) 後 left join" --> n_prep
  n_prep --> o_enriched
  n_prep --> d_segcols
  d_segcols --> n_metrics
  d_segcols --> n_baseline
  d_segcols --> n_sample
  d_segcols -- "--compare-only：讀寫 enriched 那次落地的" --> n_creport
  d_segcols -- "只取 joined：分區指紋的一部分（#374）" --> n_agg
  d_segcols -- "只取 joined" --> n_pq
  d_segcols --> n_restrict
  d_segcols --> n_validate

  o_enriched --> n_metrics
  cfg_cat --> n_metrics
  n_metrics --> d_metrics
  o_enriched --> n_baseline
  src_label -- "近 lookback_months 的歷史窗<br/>（查無資料時 raise，bug 1）" --> n_baseline
  n_baseline --> d_baseline
  o_enriched --> n_agg
  n_agg --> d_agg
  o_enriched --> n_pq
  n_pq --> d_pq

  o_enriched --> n_sample
  n_sample --> d_sample
  d_sample --> n_ci
  n_ci --> d_ci
  d_sample --> n_cs
  n_cs --> d_cs
  d_sample --> n_ia
  n_ia --> d_ia
  d_sample --> n_sup
  n_sup --> d_sup
  art_gain --> n_mc
  d_ia -- "同一次執行的 item_ability 結果" --> n_mc
  n_mc --> d_mc

  d_cs -- "依 DIAGNOSES 順序<br/>讀值並比對指紋" --> n_pages
  d_ia --> n_pages
  d_mc --> n_pages
  d_sup --> n_pages
  n_pages --> d_pages
  n_nopages --> d_pages

  d_metrics --> n_report
  d_baseline --> n_report
  d_ci --> n_report
  d_agg --> n_report
  d_pages --> n_report
  d_pq --> n_report
  n_report --> o_report

  o_enriched --> n_restrict
  o_enriched -- "--compare-only：catalog 依 model_version 讀回" --> n_validate
  n_validate --> n_restrict
  n_loadb --> d_braw
  d_braw --> n_restrict
  n_restrict --> d_common
  d_common --> n_creport
  n_creport --> o_creport

  %% ---------------------------- 樣式 -------------------------------
  classDef src fill:#a5d8ff,stroke:#1971c2,stroke-width:1.5px,color:#0b3d6b
  classDef cfg fill:#e5dbff,stroke:#7048e8,stroke-width:1.5px,color:#3b2a7a
  classDef art fill:#c3fae8,stroke:#0ca678,stroke-width:1.5px,color:#0b4f3f
  classDef nd fill:#ffffff,stroke:#57606a,stroke-width:1.5px,color:#1f2328
  classDef data fill:#f1f3f5,stroke:#adb5bd,stroke-width:1px,color:#343a40
  classDef mem fill:#ffffff,stroke:#adb5bd,stroke-width:1px,stroke-dasharray:5 3,color:#6a737d
  classDef out fill:#b2f2bb,stroke:#2f9e44,stroke-width:1.5px,color:#14532d

  class src_ranked,src_teval,src_label,src_seg src
  class cfg_cat cfg
  class art_gain art
  class n_prep,n_metrics,n_baseline,n_pq,n_agg,n_sample,n_ci,n_cs,n_ia,n_mc,n_sup,n_pages,n_nopages,n_report,n_validate,n_loadb,n_restrict,n_creport nd
  class d_ci,d_cs,d_ia,d_mc,d_sup,d_agg,d_metrics,d_baseline,d_pq data
