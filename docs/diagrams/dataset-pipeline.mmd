%% dataset pipeline node graph
%% 唯一真實來源：src/recsys_tfb/pipelines/dataset/pipeline.py::create_pipeline

%% 圖例
%%   [( 圓柱 )]  來源表（catalog 外部輸入）
%%   [ 方框 ]    node，框內是 node name（可直接餵給 --from-node / --only-node）
%%   ([ 膠囊 ])  dataset（node 的輸出，catalog 條目）
%%   {{ 六角 }}  side-effect only 的閘（outputs=None）
%%   [A][B][C]  接點記號：build node 框內的「+ A · B · C」代表它同時吃這三個
%%              輸入。三個輸入各連四個 build node ＝ 12 條橫貫線，改用接點記號
%%              表示，lineage 一條不少但圖不打結。

%% 刻意不畫
%%   - parameters：每個 node 都吃，畫出來只會蓋掉真正的資料流。
%%   - calibration 分支（enable_calibration: true 才存在）。
%%   - 函式名：四個 build node 共用 build_model_input、filter_val_model_input
%%     的函式是 filter_groups_with_positives、select_sample_keys 的函式是
%%     select_train_keys。圖上一律用 node name。

%% 編輯方式：改這個檔，然後重新渲染成 SVG 貼回 dataset-pipeline.html。
%%   - 線上：https://mermaid.live 貼上全文 → Actions → SVG
%%   - VS Code：Mermaid 系列外掛可直接預覽與匯出
%%   - 貼進 .md 的 ```mermaid 區塊，GitHub 會直接渲染
%%   - CLI（指令見 dataset-pipeline.html 末段）

%% 兩個實測過的坑
%%   1. 不要留「只有 %%、後面沒有字」的空註解行：mermaid 不會把它當註解剝掉，
%%      會黏到下一行變成 %%flowchart，parse error 指向第 1 行、很難聯想。
%%      要空行就用真正的空行。
%%   2. 渲染用 mermaid-cli@10，不要用 @11：同一張圖 v11 的新 renderer 會產出
%%      666 KB 的 SVG（形狀改用 rough.js 畫，path 灌到 30 KB 一條），v10 是 43 KB。
%% ===========================================================================

flowchart LR

  %% --------------------------- 來源表 ---------------------------
  subgraph SRC[" 來源表 "]
    direction TB
    sample_pool[("sample_pool")]
    feature_table[("feature_table")]
