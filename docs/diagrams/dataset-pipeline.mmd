  end

  %% ------------------------ 資料閘（Layer-2）---------------------
  gate{{"validate_data_consistency<br/><small>B1 / B5 / B6 · 只做檢查不產出</small>"}}
  sample_pool --> gate
  feature_table --> gate
  label_table --> gate

  %% ------------------------- Key 選取 ---------------------------
  subgraph KEYS[" Key 選取：決定每個 split 收哪些 (time, entity, item) "]
    direction TB
    n_sel_test["select_test_keys<br/><small>增量</small>"] --> d_test_keys(["test_keys"])
    n_sel_val["select_val_keys"] --> d_val_keys(["val_keys"])
    n_sel_sample["select_sample_keys"] --> d_sample_keys(["sample_keys"])
    d_sample_keys --> n_split["split_train_keys"]
    n_split --> d_train_dev_keys(["train_dev_keys"])
    n_split --> d_train_keys(["train_keys"])
  end

  sample_pool --> n_sel_sample
  sample_pool --> n_sel_val
  sample_pool --> n_sel_test

  %% -------------------------- 前處理 ----------------------------
  subgraph PREP[" 前處理：只用 train 月份 fit，編碼一次供所有 split 共用 "]
    direction TB
    n_fit["fit_preprocessor_metadata"] --> d_preprocessor(["preprocessor　<b>[C]</b>"])
    n_fit --> d_catmap(["category_mappings"])
    n_apply["apply_preprocessor_to_features<br/><small>增量</small>"] --> d_pft(["preprocessed_feature_table　<b>[A]</b>"])
  end

  feature_table --> n_fit
  feature_table --> n_apply
  d_preprocessor --> n_apply

  %% ---------------------- 組裝 model input -----------------------
  subgraph BUILD[" 組裝 model input：keys ⨝ label ⨝ 編碼後 features "]
    direction TB
    n_b_test["build_test_model_input<br/><small>增量 ・ ＋ A · B · C</small>"] --> d_test_unf(["test_model_input_unfiltered"])
    d_test_unf --> n_f_test["filter_test_model_input<br/><small>增量 ・ 去掉零正例</small>"]
    n_f_test --> o_test(["test_model_input"])
    n_b_val["build_val_model_input<br/><small>＋ A · B · C</small>"] --> d_val_unf(["val_model_input_unfiltered"])
    d_val_unf --> n_f_val["filter_val_model_input<br/><small>去掉零正例 query group</small>"]
    n_f_val --> o_val(["val_model_input"])
    n_b_traindev["build_train_dev_model_input<br/><small>＋ A · B · C</small>"] --> o_traindev(["train_dev_model_input"])
    n_b_train["build_train_model_input<br/><small>＋ A · B · C</small>"] --> o_train(["train_model_input"])
  end

  d_test_keys --> n_b_test
  d_val_keys --> n_b_val
  d_train_dev_keys --> n_b_traindev
  d_train_keys --> n_b_train

